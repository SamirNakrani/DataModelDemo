<?xml version="1.0" encoding="utf-8"?>
<Application Title="DataModelDemo">
  <BOModel>
    <Class Name="DataModelDemo.Module.BusinessObjects.DemoTask">
      <OwnMembers>
        <Member Name="DueDate" DisplayFormat="D" />
        <Member Name="PercentCompleted" DisplayFormat="{0:N0}%" />
      </OwnMembers>
    </Class>
  </BOModel>
  <Options>
    <LayoutManagerOptions RequiredFieldMark="*" />
  </Options>
  <SchemaModules>
    <SchemaModule Name="SystemModule" Version="25.2.3.0" IsNewNode="True" />
  </SchemaModules>
</Application>